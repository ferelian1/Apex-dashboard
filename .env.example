# =============================================================================
# Apex Dashboard — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or any file containing real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Supabase Postgres)
# -----------------------------------------------------------------------------

# PgBouncer connection string (port 6543) — used by Prisma for all queries.
# Append ?pgbouncer=true to prevent connection exhaustion in serverless.
# Requirement 13.2
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection string (port 5432) — used by Prisma for migrations only.
# Requirement 13.3
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# -----------------------------------------------------------------------------
# Clerk Authentication
# -----------------------------------------------------------------------------

# Public key — safe to expose to the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."

# Secret key — server-side only, never expose to the browser.
CLERK_SECRET_KEY="sk_test_..."

# Webhook signing secret — used to verify Svix signatures on /api/webhooks/clerk.
CLERK_WEBHOOK_SECRET="whsec_..."

# Redirect URLs after sign-in / sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# -----------------------------------------------------------------------------
# Guest Demo Account (Requirement 8.3)
# -----------------------------------------------------------------------------

# Password for the pre-seeded guest@apex-demo.com Clerk account.
GUEST_USER_PASSWORD="change-me-in-production"

# -----------------------------------------------------------------------------
# Supabase (Realtime)
# -----------------------------------------------------------------------------

# Public URL and anon key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# Service role key — server-side only, grants full database access.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."
